# Telegram Bot (for contact form notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# PostgreSQL Database URL (Render provides this)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/codexai

# IndexNow key for SEO
INDEXNOW_KEY=codexai-indexnow-key

# Port (Render sets this automatically)
PORT=3000
